APP_USERNAME=admin
APP_PASSWORD=请替换为强密码
SESSION_SECRET=请替换为至少32位的随机字符串
COOKIE_SECURE=false
ENABLE_SCHEDULER=true
DATABASE_PATH=/app/data/screening.db
OUTPUT_FILE=/app/data/ths_board_screen_result.csv
# 以百分数填写；小波段不达标时会继续向左寻找更大级别波段
MIN_WAVE_RISE_PERCENT=10
# 直接通过公网 IP 访问时改为 0.0.0.0；使用 Nginx/Caddy 反向代理时保持 127.0.0.1
APP_BIND_HOST=127.0.0.1
